# Kopieer naar .env (of zet als GitHub Actions-variabelen). Er zijn geen geheime sleutels nodig.

# Contact in de User-Agent, zodat bronbeheerders je kunnen bereiken (aanbevolen).
COLLECTOR_CONTACT=jouw-adres@example.org

# Optioneel: adressen omzetten naar coördinaten via OpenStreetMap Nominatim (max. 1 verzoek/s, gecachet).
# GEOCODER=nominatim
# NOMINATIM_EMAIL=jouw-adres@example.org

# Optioneel: ander databasebestand (standaard data/agenda.sqlite).
# DB_FILE=data/agenda.sqlite

# Alleen voor testen: doe alsof het een andere dag is (YYYY-MM-DD).
# TODAY_OVERRIDE=2026-10-21
